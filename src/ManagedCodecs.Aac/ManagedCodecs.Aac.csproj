<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ManagedCodecs.Aac</RootNamespace>
    <PackageId>ManagedCodecs.Aac</PackageId>
    <IsAotCompatible>true</IsAotCompatible>
    <DefineConstants>$(DefineConstants);MANAGEDCODECS_AAC</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ManagedCodecs.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ManagedCodecs.Core\ManagedCodecs.Core.csproj" />
  </ItemGroup>

</Project>
