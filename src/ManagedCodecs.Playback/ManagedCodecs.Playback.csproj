<Project Sdk="Microsoft.NET.Sdk">

  <!-- Playing a video file in a game engine (issue #352; docs/decisions/2026-10-31-game-engines.md): a thread that
       demuxes, decodes and converts to RGBA ahead of playback, and the game loop's pull of the frame that is due. No
       engine's API: MonoGame, Godot and Unity (through ManagedCodecs.Unity, which compiles these sources) each copy the
       frames into their own texture. A package of its own, so a consumer who only decodes takes on none of it. -->
  <PropertyGroup>
    <RootNamespace>ManagedCodecs.Playback</RootNamespace>
    <PackageId>ManagedCodecs.Playback</PackageId>
    <Description>Video playback for game engines (MonoGame, FNA, Godot .NET, Stride): H.264 or MJPEG with AAC or MP3 from MP4, Matroska, WebM or AVI, decoded on a thread of its own into RGBA frames for a texture and 32-bit float stereo for a sound, in pure managed C#.</Description>
    <PackageTags>$(PackageTags);playback;video-player;game;monogame;godot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Its own page on nuget.org in place of the shared PACKAGE.md (Directory.Build.props). -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\PACKAGE.md" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ManagedCodecs.Tests" />
    <!-- mcdec live mode (tools/ManagedCodecs.Cli/LiveCheck.cs) converts a file's frames as LivePlayer does, to compare. -->
    <InternalsVisibleTo Include="mcdec" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ManagedCodecs.Core\ManagedCodecs.Core.csproj" />
    <ProjectReference Include="..\ManagedCodecs.Containers\ManagedCodecs.Containers.csproj" />
    <ProjectReference Include="..\ManagedCodecs.Mjpeg\ManagedCodecs.Mjpeg.csproj" />
    <ProjectReference Include="..\ManagedCodecs.H264\ManagedCodecs.H264.csproj" />
    <ProjectReference Include="..\ManagedCodecs.Aac\ManagedCodecs.Aac.csproj" />
    <ProjectReference Include="..\ManagedCodecs.Mp3\ManagedCodecs.Mp3.csproj" />
  </ItemGroup>

</Project>
