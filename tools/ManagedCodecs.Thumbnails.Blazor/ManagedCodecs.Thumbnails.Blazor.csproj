<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- A Blazor WebAssembly sample of ManagedCodecs.Thumbnails (docs/decisions/2026-10-31-thumbnails.md, pull request 5):
       a file picked in the browser is probed and thumbnailed there, nothing uploaded. Outside ManagedCodecs.slnx, as
       tools/ManagedCodecs.Wasm is: CI's wasm job publishes it (trimmed, warnings as errors). README.md. -->
  <PropertyGroup>
    <RootNamespace>ManagedCodecs.ThumbnailsBlazor</RootNamespace>
    <IsPackable>false</IsPackable>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\ManagedCodecs.Thumbnails\ManagedCodecs.Thumbnails.csproj" />
  </ItemGroup>

</Project>
