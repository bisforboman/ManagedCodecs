<Project Sdk="Microsoft.NET.Sdk">

  <!-- mcdec on the Unity build (src/ManagedCodecs.Unity), for Mono: tools/unity-check.sh runs it with mono and
       compares every sample's output with the net10.0 mcdec's. The same sources as tools/ManagedCodecs.Cli, built for
       netstandard2.1 (which Mono runs as an exe), with HarnessPolyfills.cs for the newer APIs mcdec itself uses.
       Outside the solution: it is a test harness for one script. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>mcdec</AssemblyName>
    <RootNamespace>ManagedCodecs.Cli</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- A netstandard2.1 build doesn't copy its package dependencies (System.Runtime.CompilerServices.Unsafe) to the
         output; Mono loads them from beside mcdec.dll. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- ThumbnailOutput.cs and the thumbnail hash mode: the Unity package has ManagedCodecs.Thumbnails too. -->
    <DefineConstants>$(DefineConstants);THUMBNAILS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ManagedCodecs.Cli\*.cs" Link="Cli\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\ManagedCodecs.Unity\Polyfills.cs" Link="Polyfills.cs" />
    <ProjectReference Include="..\..\src\ManagedCodecs.Unity\ManagedCodecs.Unity.csproj" />
  </ItemGroup>

</Project>
