<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>mcdec</AssemblyName>
    <RootNamespace>ManagedCodecs.Cli</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- A benchmark tool: compile fully optimized code on first call, so short runs aren't timed on unoptimized code. -->
    <TieredCompilation>false</TieredCompilation>
    <!-- ThumbnailOutput.cs and the thumbnail hash mode: not in the Unity build of mcdec (tools/ManagedCodecs.Cli.Unity), which
         compiles these sources against a package without Thumbnails. -->
    <DefineConstants>$(DefineConstants);THUMBNAILS</DefineConstants>
    <!-- LiveCheck.cs and mcdec live mode: LivePlayer, and Playback's frame conversion (InternalsVisibleTo mcdec), which the Unity
         build of mcdec can't see. -->
    <DefineConstants>$(DefineConstants);LIVE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ManagedCodecs.Containers\ManagedCodecs.Containers.csproj" />
    <ProjectReference Include="..\..\src\ManagedCodecs.Mjpeg\ManagedCodecs.Mjpeg.csproj" />
    <ProjectReference Include="..\..\src\ManagedCodecs.H264\ManagedCodecs.H264.csproj" />
    <ProjectReference Include="..\..\src\ManagedCodecs.Aac\ManagedCodecs.Aac.csproj" />
    <ProjectReference Include="..\..\src\ManagedCodecs.Mp3\ManagedCodecs.Mp3.csproj" />
    <ProjectReference Include="..\..\src\ManagedCodecs.Thumbnails\ManagedCodecs.Thumbnails.csproj" />
    <ProjectReference Include="..\..\src\ManagedCodecs.Playback\ManagedCodecs.Playback.csproj" />
  </ItemGroup>

  <!-- A static PGO profile for a Native AOT publish (-p:McdecMibc=<file>.mibc, made with dotnet-pgo from a trace): ILC's
       MibcFile item (#346). -->
  <ItemGroup Condition="'$(McdecMibc)' != ''">
    <MibcFile Include="$(McdecMibc)" />
  </ItemGroup>

</Project>
