<Project>
  <PropertyGroup>
    <StyleBroPreset>1.0</StyleBroPreset>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleBro.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- The packages' public API, listed in each src/ project's PublicAPI.Shipped.txt (as of the last release) and
       PublicAPI.Unshipped.txt (changed since): a public member added, changed or removed without its line there fails
       the build (RS0016, RS0017), so every API change shows in the pull request. A release moves Unshipped into Shipped. -->
  <ItemGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- The src/ libraries' XML documentation ships in their packages (lib/net10.0/*.xml), for IntelliSense; a public
       member without a doc comment fails the build (CS1591, with -warnaserror as CI builds). Comments may name some of
       a method's parameters and not others (CS1573), as many internal ones do. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1573</NoWarn>
  </PropertyGroup>

  <!-- Package validation: packing compares each src/ package with its baseline version on nuget.org, and fails on a
       public API change that breaks it (CP0002 for a removed member, CP0005 and others). The baseline is the last
       release: each release PR sets it to the version before its own (its own is not on nuget.org yet), so a member
       added in one patch and removed in the next fails too. A deliberate break, in a new minor version only
       (CHANGELOG.md's promise), is accepted by packing with -p:ApiCompatGenerateSuppressionFile=true, which writes
       the project's CompatibilitySuppressions.xml; those files go once the baseline is past the breaking release.
       CI packs on every pull request (ci.yml). The meta-package has no assemblies to compare. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/')) And '$(MSBuildProjectName)' != 'ManagedCodecs'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.2.2</PackageValidationBaselineVersion>
    <!-- CP0003, an assembly version below the baseline's: local and CI builds are 0.0.0-dev; a release's version is
         always above the last. -->
    <NoWarn>$(NoWarn);CP0003</NoWarn>
  </PropertyGroup>

  <!-- Shared package metadata for the src/ libraries. Every package has one version, the newest in CHANGELOG.md, given
       at pack time (release.yml: dotnet pack -p:Version=X); local builds are 0.0.0-dev. -->
  <PropertyGroup>
    <Version>0.0.0-dev</Version>
    <Authors>Jakob Boman</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>video;audio;codec;decoder;mjpeg;h264;aac;avi;mp4;pure-managed;aot</PackageTags>
    <Description>Pure managed C# media codecs. No native binaries, Native AOT friendly.</Description>
    <PackageProjectUrl>https://github.com/bisforboman/ManagedCodecs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bisforboman/ManagedCodecs</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- nuget.org's page for every package: PACKAGE.md, short and with absolute links (README's relative ones break
       there). -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <None Include="$(MSBuildThisFileDirectory)PACKAGE.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
