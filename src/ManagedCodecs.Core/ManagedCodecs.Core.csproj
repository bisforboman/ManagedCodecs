<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ManagedCodecs</RootNamespace>
    <PackageId>ManagedCodecs.Core</PackageId>
    <Description>ManagedCodecs' shared types: VideoFrame, AudioFrame, Packet, PixelFormat, Rational and the demuxer and decoder interfaces. Pure managed, Native AOT friendly.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ManagedCodecs.H264" />
    <InternalsVisibleTo Include="ManagedCodecs.Mjpeg" />
    <InternalsVisibleTo Include="ManagedCodecs.Containers" />
    <InternalsVisibleTo Include="ManagedCodecs.Aac" />
    <InternalsVisibleTo Include="ManagedCodecs.Tests" />
  </ItemGroup>

</Project>
