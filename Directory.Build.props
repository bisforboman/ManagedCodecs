<Project>
  <PropertyGroup>
    <StyleBroPreset>1.0</StyleBroPreset>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- No vulnerable package, direct or transitive, in anything the repository builds or ships (the owner's decision,
       docs/decisions/2026-11-06-vulnerable-packages.md): restore audits every package of every project, the tools,
       samples, tests and benchmarks too, against nuget.org's advisories, and an advisory of any severity fails the
       build (NU1901 low to NU1904 critical), locally as in CI, pack and release. Fix one by moving the package (a
       PackageVersion in Directory.Packages.props, with a comment naming the advisory), never by suppressing it.
       NU1905 (the audit source can't be read) stays a warning. vulnerable-packages.yml checks main weekly, for
       advisories published after a restore passed. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- The .NET SDK's security analyzers (category Security: CA2xxx, CA3xxx, CA5xxx) all run on every build of every
       project, and each finding is an error there, not only where -warnaserror is on (the owner's decision,
       docs/decisions/2026-11-06-security-analyzers.md). AnalysisModeSecurity=All makes the SDK add its global config
       enabling every Security rule; the suffix, a private SDK property, picks that config's variant with each rule at
       error (what CodeAnalysisTreatWarningsAsErrors would pick, but for Security only: that property would also make
       the other categories' default rules errors). A category line in .editorconfig can't do it: the global config's
       per-rule severities win over a category's. The SDK runs its analyzers on net5.0 and later only, with
       AnalysisLevel set there: EnableNETAnalyzers and AnalysisLevelSecurity bring the Security rules (and only them)
       to the netstandard2.1 Unity builds too. CheckSecurityAnalyzers (Directory.Build.targets) fails the build if a
       project or an SDK stops honouring this. A false positive is suppressed where it is, with a justification. -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevelSecurity>latest</AnalysisLevelSecurity>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <_GlobalAnalyzerConfigFileName_MicrosoftCodeAnalysisNetAnalyzersSecurity_WarnAsErrorSuffix>_warnaserror</_GlobalAnalyzerConfigFileName_MicrosoftCodeAnalysisNetAnalyzersSecurity_WarnAsErrorSuffix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleBro.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- The packages' public API, listed in each src/ project's PublicAPI.Shipped.txt (as of the last release) and
       PublicAPI.Unshipped.txt (changed since): a public member added, changed or removed without its line there fails
       the build (RS0016, RS0017), so every API change shows in the pull request. A release moves Unshipped into Shipped. -->
  <ItemGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- The src/ libraries' XML documentation ships in their packages (lib/net10.0/*.xml), for IntelliSense; a public
       member without a doc comment fails the build (CS1591, with -warnaserror as CI builds). Comments may name some of
       a method's parameters and not others (CS1573), as many internal ones do. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1573</NoWarn>
  </PropertyGroup>

  <!-- Package validation: packing compares each src/ package with its baseline version on nuget.org, and fails on a
       public API change that breaks it (CP0002 for a removed member, CP0005 and others). The baseline is the last
       release: once a release is on nuget.org, a pull request of its own sets it to that version (the release PR
       can't: its version is not on nuget.org while its checks run), so a member a release added and the next one
       removes fails too. A deliberate break, in a new minor version only
       (CHANGELOG.md's promise), is accepted by packing with -p:ApiCompatGenerateSuppressionFile=true, which writes
       the project's CompatibilitySuppressions.xml; those files go once the baseline is past the breaking release.
       CI packs on every pull request (ci.yml). The meta-package has no assemblies to compare. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/')) And '$(MSBuildProjectName)' != 'ManagedCodecs'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.8.0</PackageValidationBaselineVersion>
    <!-- CP0003, an assembly version below the baseline's: local and CI builds are 0.0.0-dev; a release's version is
         always above the last. -->
    <NoWarn>$(NoWarn);CP0003</NoWarn>
  </PropertyGroup>

  <!-- Shared package metadata for the src/ libraries. Every package has one version, the newest in CHANGELOG.md, given
       at pack time (release.yml: dotnet pack -p:Version=X); local builds are 0.0.0-dev. -->
  <PropertyGroup>
    <Version>0.0.0-dev</Version>
    <Authors>Jakob Boman</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>video;audio;codec;decoder;mjpeg;h264;aac;avi;mp4;pure-managed;aot</PackageTags>
    <Description>Pure managed C# media codecs. No native binaries, Native AOT friendly.</Description>
    <PackageProjectUrl>https://github.com/bisforboman/ManagedCodecs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bisforboman/ManagedCodecs</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- nuget.org's page for every package: PACKAGE.md, short and with absolute links (README's relative ones break
       there). And THIRD-PARTY-NOTICES.md beside it: the BSD and Apache notices of the tables transcribed from other
       projects go wherever the code goes. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <None Include="$(MSBuildThisFileDirectory)PACKAGE.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
