<Project Sdk="Microsoft.NET.Sdk">

  <!-- mclive-maui: a live camera in .NET MAUI (issue #526, docs/decisions/2026-11-17-live-maui.md): a sample, not a
       package, whose LiveView and its handler per platform an application copies. Android and Windows first (the
       owner's decision); iOS and Mac Catalyst later. Not in ManagedCodecs.slnx: it needs MAUI's workloads
       (`dotnet workload install maui-android`, and the Android SDK), which the other jobs don't install, and the
       Windows target builds on Windows only. .github/workflows/maui.yml builds and runs it. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <!-- Directory.Build.props sets one TargetFramework for every project; this one has several. -->
    <TargetFramework></TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <AssemblyName>mclive-maui</AssemblyName>
    <RootNamespace>ManagedCodecs.MauiSample</RootNamespace>
    <IsPackable>false</IsPackable>
    <ApplicationTitle>mclive-maui</ApplicationTitle>
    <ApplicationId>io.github.managedcodecs.mclive</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <!-- Windows: an .exe that runs as it is (as mclive-wpf), not an MSIX to install, so CI can start it with arguments. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- The Windows App SDK compiles a file of its own into a self-contained unpackaged app,
       UndockedRegFreeWinRT-AutoInitializer.cs (from the NuGet cache), whose P/Invoke of the SDK's own bootstrap DLL
       has no DefaultDllImportSearchPaths: CA5392, an error here as every Security rule is
       (docs/decisions/2026-11-06-security-analyzers.md). Not this repository's code and not ours to change, so the
       rule is off for that one file only, by a global config naming its full path (a .editorconfig can't reach the
       NuGet cache); any other file keeps the rule. Checked on Linux with a stand-in of that name: it builds, and the
       same code under another name fails. -->
  <Target Name="SuppressWindowsAppSdkInitializerFinding" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_WindowsAppSdkInitializer Include="@(Compile)" Condition="'%(Filename)' == 'UndockedRegFreeWinRT-AutoInitializer'" />
    </ItemGroup>
    <PropertyGroup>
      <_WindowsAppSdkInitializerPath>@(_WindowsAppSdkInitializer->'%(FullPath)')</_WindowsAppSdkInitializerPath>
      <_WindowsAppSdkInitializerPath>$([System.String]::Copy('$(_WindowsAppSdkInitializerPath)').Replace('\', '/'))</_WindowsAppSdkInitializerPath>
      <_WindowsAppSdkInitializerConfig>$(IntermediateOutputPath)windowsappsdk-initializer.globalconfig</_WindowsAppSdkInitializerConfig>
    </PropertyGroup>
    <WriteLinesToFile Condition="'$(_WindowsAppSdkInitializerPath)' != ''" File="$(_WindowsAppSdkInitializerConfig)"
                      Lines="is_global = true;[$(_WindowsAppSdkInitializerPath)];dotnet_diagnostic.CA5392.severity = none"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup Condition="'$(_WindowsAppSdkInitializerPath)' != ''">
      <EditorConfigFiles Include="$(_WindowsAppSdkInitializerConfig)" />
    </ItemGroup>
  </Target>

  <!-- iOS and Mac Catalyst share one handler and entry point (Platforms/Apple), compiled for those two only; each has
       its own Info.plist (and Mac Catalyst its Entitlements.plist) in its own folder, where MAUI looks for them. -->
  <ItemGroup>
    <Compile Remove="Platforms\Apple\**" />
    <Compile Include="Platforms\Apple\**\*.cs" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ManagedCodecs.Playback\ManagedCodecs.Playback.csproj" />
  </ItemGroup>

</Project>
