<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The fuzz targets (tools/ManagedCodecs.Fuzz) and the inputs it found, replayed by MalformedInputTests. -->
  <ItemGroup>
    <Compile Include="..\..\tools\ManagedCodecs.Fuzz\Targets.cs" Link="Fuzz\Targets.cs" />
    <None Include="Fuzz\Findings\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- -p:UnityBuild=true: the same tests against the Unity build (src/ManagedCodecs.Unity, netstandard2.1, the scalar
       paths), as ci.yml runs them; tests of the vector paths themselves are left out (UNITY_BUILD). -->
  <PropertyGroup Condition="'$(UnityBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);UNITY_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(UnityBuild)' == 'true'">
    <Compile Remove="**\VectorZipTests.cs" />
    <!-- ManagedCodecs.MonoGame is net10.0 only, not part of the Unity build. -->
    <Compile Remove="MonoGame\**" />
    <ProjectReference Include="..\..\src\ManagedCodecs.Unity\ManagedCodecs.Unity.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UnityBuild)' != 'true'">
    <ProjectReference Include="..\..\src\ManagedCodecs.Core\ManagedCodecs.Core.csproj" />
    <ProjectReference Include="..\..\src\ManagedCodecs.Containers\ManagedCodecs.Containers.csproj" />
    <ProjectReference Include="..\..\src\ManagedCodecs.Mjpeg\ManagedCodecs.Mjpeg.csproj" />
    <ProjectReference Include="..\..\src\ManagedCodecs.H264\ManagedCodecs.H264.csproj" />
    <ProjectReference Include="..\..\src\ManagedCodecs.Aac\ManagedCodecs.Aac.csproj" />
    <ProjectReference Include="..\..\src\ManagedCodecs.Mp3\ManagedCodecs.Mp3.csproj" />
    <ProjectReference Include="..\..\src\ManagedCodecs.Thumbnails\ManagedCodecs.Thumbnails.csproj" />
    <ProjectReference Include="..\..\src\ManagedCodecs.Playback\ManagedCodecs.Playback.csproj" />
    <ProjectReference Include="..\..\src\ManagedCodecs.MonoGame\ManagedCodecs.MonoGame.csproj" />
    <!-- The package compiles against MonoGame without passing it on (a game brings its platform's); its tests need it. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
  </ItemGroup>

</Project>
