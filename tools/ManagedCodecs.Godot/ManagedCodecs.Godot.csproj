<Project Sdk="Godot.NET.Sdk/4.7.2">

  <!-- A Godot 4 (.NET) sample for issue #254: addons/managedcodecs/, an addon whose ManagedCodecsVideo is a
       TextureRect that plays a video file into an ImageTexture, its audio through an AudioStreamGenerator, decoded by
       the ManagedCodecs.Playback package. CI
       builds it with the Godot .NET SDK from nuget.org; Godot itself (the editor, which runs it) is not installed
       there. First runs, on Windows: issue #402 (README.md). -->
  <PropertyGroup>
    <AssemblyName>ManagedCodecs.Godot</AssemblyName>
    <RootNamespace>ManagedCodecs.GodotAddon</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Here, not only in Directory.Build.props: Godot reads the .csproj alone, and opening the folder in the editor would
         add its own default (net8.0), which the net10.0 packages don't build against. -->
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Always Release: the .NET SDK optimises only a configuration named Release, and Godot builds Debug (F5, the command
       line), ExportDebug or ExportRelease, which would all reach the decoders unoptimised, about 4 times slower at
       1080p (issue #402). An item definition, so that it also reaches the references the SDK adds transitively (the
       decoders), which would otherwise build in Godot's configuration. A game using the package from nuget.org gets
       its Release build anyway. -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <SetConfiguration>Configuration=Release</SetConfiguration>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ManagedCodecs.Playback\ManagedCodecs.Playback.csproj" />
  </ItemGroup>

</Project>
