<Project Sdk="Godot.NET.Sdk/4.7.2">

  <!-- A Godot 4 (.NET) sample for issue #254: addons/managedcodecs/, an addon whose ManagedCodecsVideo is a
       TextureRect that plays a video file into an ImageTexture, its audio through an AudioStreamGenerator, decoded by
       the ManagedCodecs.Playback package. CI
       builds it with the Godot .NET SDK from nuget.org; Godot itself (the editor, which runs it) is not installed
       there, so it has not been run (README.md). -->
  <PropertyGroup>
    <AssemblyName>ManagedCodecs.Godot</AssemblyName>
    <RootNamespace>ManagedCodecs.GodotAddon</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Here, not only in Directory.Build.props: Godot reads the .csproj alone, and opening the folder in the editor would
         add its own default (net8.0), which the net10.0 packages don't build against. -->
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ManagedCodecs.Playback\ManagedCodecs.Playback.csproj" />
  </ItemGroup>

</Project>
