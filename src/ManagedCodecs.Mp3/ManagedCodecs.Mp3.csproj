<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ManagedCodecs.Mp3</RootNamespace>
    <PackageId>ManagedCodecs.Mp3</PackageId>
    <Description>MP3 decoder (MPEG audio Layer III at every MPEG-1, MPEG-2 and MPEG-2.5 sample rate; mono, stereo and joint stereo), checked against FFmpeg, in pure managed C#.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <DefineConstants>$(DefineConstants);MANAGEDCODECS_MP3</DefineConstants>
    <!-- No release of this package on nuget.org yet, so package validation has no baseline to compare with (the one in
         Directory.Build.props is the other packages'); the pull request that sets the baseline after its first release
         removes this line. -->
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ManagedCodecs.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ManagedCodecs.Core\ManagedCodecs.Core.csproj" />
  </ItemGroup>

</Project>
